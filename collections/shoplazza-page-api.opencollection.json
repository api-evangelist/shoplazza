{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPZ Admin Access Page API",
    "version": "2022.01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access-token",
      "value": "{{access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Page",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Page List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/pages",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Limit per page, e.g. 50"
              }
            ]
          },
          "docs": "Get Page List"
        },
        {
          "info": {
            "name": "Create Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/pages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Page"
        },
        {
          "info": {
            "name": "Get Page Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/pages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Page's ID"
              }
            ]
          },
          "docs": "Get Page Details"
        },
        {
          "info": {
            "name": "Update Page",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/pages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Page's id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Page"
        },
        {
          "info": {
            "name": "Delete Page",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-07/pages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Page's id"
              }
            ]
          },
          "docs": "Delete Page"
        },
        {
          "info": {
            "name": "Count Page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/pages/count",
            "params": [
              {
                "name": "title",
                "value": "",
                "type": "query",
                "description": "The title of the page."
              }
            ]
          },
          "docs": "Count Page"
        }
      ]
    }
  ],
  "bundled": true
}