{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPZ Admin Access App Proxy API",
    "version": "2022.01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access-token",
      "value": "{{access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "App Proxy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get App Proxy List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/app-proxies",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Record count in every page, default: 20"
              }
            ]
          },
          "docs": "Get App Proxy List"
        },
        {
          "info": {
            "name": "Create App Proxy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/app-proxies",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create App Proxy"
        },
        {
          "info": {
            "name": "App Proxy Count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/app-proxies/count"
          },
          "docs": "App Proxy Count"
        },
        {
          "info": {
            "name": "App Proxy Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/app-proxies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "App proxy's ID"
              }
            ]
          },
          "docs": "App Proxy Details"
        },
        {
          "info": {
            "name": "Delete App Proxy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/app-proxies/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "App proxy's ID"
              }
            ]
          },
          "docs": "Delete App Proxy"
        }
      ]
    }
  ],
  "bundled": true
}