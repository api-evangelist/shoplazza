{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPZ Admin Access Webhook API",
    "version": "2022.01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access-token",
      "value": "{{access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhook",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Webhook List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.myshoplaza.com/openapi/2022-01/webhooks",
            "params": [
              {
                "name": "address",
                "value": "",
                "type": "query",
                "description": "Webhook notification URL, e.g. `https://example.com/webhook`"
              },
              {
                "name": "topic",
                "value": "",
                "type": "query",
                "description": "The event name, e.g. `orders/cancelled,orders/create`"
              },
              {
                "name": "created_at_min",
                "value": "",
                "type": "query",
                "description": "Filter webhook records created at after date, e.g. `2018-08-26T06:19:53Z`"
              },
              {
                "name": "created_at_max",
                "value": "",
                "type": "query",
                "description": "Filter webhook records created at before date, e.g. `2018-08-26T06:19:53Z`"
              },
              {
                "name": "updated_at_min",
                "value": "",
                "type": "query",
                "description": "Filter webhook records last update at after date, e.g. `2018-08-26T06:19:53Z`"
              },
              {
                "name": "updated_at_max",
                "value": "",
                "type": "query",
                "description": "Filter webhook records last update at before date, e.g. `2018-08-26T06:19:53Z`"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Result per page, max: `250`"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              }
            ]
          },
          "docs": "Webhook List"
        },
        {
